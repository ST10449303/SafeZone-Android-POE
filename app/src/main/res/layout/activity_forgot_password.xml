<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/safezone_white"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- SafeZone Top Navigation -->
        <TextView
            android:id="@+id/tvHeader"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@color/safezone_navy"
            android:gravity="center"
            android:text="SafeZone"
            android:textColor="@color/safezone_white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Main Content -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="22dp"
            android:paddingBottom="30dp">

            <!-- SafeZone Logo -->
            <ImageView
                android:id="@+id/imgSafeZoneLogo"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:contentDescription="SafeZone Logo"
                android:scaleType="fitCenter"
                android:src="@drawable/safezone_logo" />

            <!-- Title -->
            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:text="Forgot Password?"
                android:textColor="@color/safezone_dark"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- Instructions -->
            <TextView
                android:id="@+id/tvInstructions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:gravity="center"
                android:text="Enter your email address to reset your SafeZone password."
                android:textColor="@color/safezone_grey"
                android:textSize="14sp" />

            <!-- Email Field -->
            <EditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="28dp"
                android:background="@drawable/rounded_login_input"
                android:drawableStart="@drawable/ic_email"
                android:drawablePadding="14dp"
                android:hint="Email Address"
                android:inputType="textEmailAddress"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/safezone_dark"
                android:textColorHint="@color/safezone_grey"
                android:textSize="16sp" />

            <!-- Reset Password Button -->
            <Button
                android:id="@+id/btnSendCode"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="16dp"
                android:backgroundTint="@color/safezone_navy"
                android:text="Reset Password"
                android:textAllCaps="false"
                android:textColor="@color/safezone_white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Divider -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:orientation="horizontal">

                <View
                    android:id="@+id/dividerLeft"
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="@color/safezone_grey" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:text="OR"
                    android:textColor="@color/safezone_grey"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <View
                    android:id="@+id/dividerRight"
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="@color/safezone_grey" />

            </LinearLayout>

            <!-- Remember Password -->
            <TextView
                android:id="@+id/tvRemember"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center"
                android:text="Remember your password?"
                android:textColor="@color/safezone_grey"
                android:textSize="14sp" />

            <!-- Back to log in -->
            <TextView
                android:id="@+id/tvBackToLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="Back to Personal Login"
                android:textColor="@color/safezone_blue"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>