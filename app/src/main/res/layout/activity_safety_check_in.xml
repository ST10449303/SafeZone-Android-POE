<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F7FA">

    <!-- =====================================================
         SAFEZONE HEADER
         ===================================================== -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/safezone_navy"
        android:paddingStart="8dp"
        android:paddingEnd="12dp">

        <!-- BACK -->

        <TextView
            android:id="@+id/tvBack"
            android:layout_width="50dp"
            android:layout_height="54dp"
            android:gravity="center"
            android:text="‹"
            android:textColor="#FFFFFF"
            android:textSize="38sp"
            android:textStyle="normal"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Back" />

        <!-- TITLE -->

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="SafeZone"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- HEADER SPACER -->

        <View
            android:layout_width="50dp"
            android:layout_height="50dp" />

    </LinearLayout>


    <!-- =====================================================
         MAIN CONTENT
         ===================================================== -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="22dp"
            android:paddingBottom="30dp">


            <!-- =================================================
                 SAFETY CHECK-IN ICON
                 ================================================= -->

            <ImageView
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/bg_checkin_icon"
                android:padding="19dp"
                android:src="@drawable/ic_checkin"
                android:contentDescription="Safety check-in" />


            <!-- =================================================
                 TITLE
                 ================================================= -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="Safety Check-In"
                android:textColor="#0B1F3A"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="Let someone you trust know that you're safe."
                android:textColor="#667085"
                android:textSize="14sp" />


            <!-- =================================================
                 DURATION
                 ================================================= -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Check-In Duration"
                android:textColor="#0B1F3A"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Choose how long you want your safety check-in to remain active."
                android:textColor="#667085"
                android:textSize="13sp" />


            <!-- =================================================
                 DURATION ROW 1
                 ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="105dp"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn30Minutes"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp"
                    android:background="@drawable/bg_checkin_option"
                    android:backgroundTint="@null"
                    android:stateListAnimator="@null"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="6dp"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:text="30 Minutes"
                    android:textAllCaps="false"
                    android:textColor="#172033"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn1Hour"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:background="@drawable/bg_checkin_option"
                    android:backgroundTint="@null"
                    android:stateListAnimator="@null"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="6dp"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:text="1 Hour"
                    android:textAllCaps="false"
                    android:textColor="#172033"
                    android:textSize="15sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- =================================================
                 DURATION ROW 2
                 ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="105dp"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn2Hours"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp"
                    android:background="@drawable/bg_checkin_option"
                    android:backgroundTint="@null"
                    android:stateListAnimator="@null"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="6dp"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:text="2 Hours"
                    android:textAllCaps="false"
                    android:textColor="#172033"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnCustom"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:background="@drawable/bg_checkin_option"
                    android:backgroundTint="@null"
                    android:stateListAnimator="@null"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="6dp"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:text="Custom"
                    android:textAllCaps="false"
                    android:textColor="#172033"
                    android:textSize="15sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- =================================================
                 SELECTED DURATION
                 ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="78dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_selected_assistance"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <ImageView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_icon_circle_blue"
                    android:padding="10dp"
                    android:src="@drawable/ic_checkin"
                    android:contentDescription="Selected duration" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="11dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Selected Duration"
                        android:textColor="#0B1F3A"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSelectedDuration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Duration: 30 minutes"
                        android:textColor="#667085"
                        android:textSize="13sp" />

                </LinearLayout>

            </LinearLayout>


            <!-- =================================================
                 TRUSTED CONTACT
                 ================================================= -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Trusted Contact"
                android:textColor="#0B1F3A"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Choose who should receive your safety check-in."
                android:textColor="#667085"
                android:textSize="13sp" />


            <!-- CONTACT SELECTOR -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginTop="11dp"
                android:background="@drawable/bg_white_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="10dp">

                <ImageView
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_icon_circle_blue"
                    android:padding="10dp"
                    android:src="@drawable/ic_person"
                    android:contentDescription="Trusted contact" />

                <Spinner
                    android:id="@+id/spTrustedContact"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_spinner"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:spinnerMode="dropdown" />

            </LinearLayout>


            <!-- =================================================
                 LOCATION SHARING
                 ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="88dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_white_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="13dp">

                <ImageView
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_icon_circle_blue"
                    android:padding="10dp"
                    android:src="@drawable/ic_location"
                    android:contentDescription="Location sharing" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="11dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Share Location"
                        android:textColor="#172033"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Allow your trusted contact to see your current location."
                        android:textColor="#667085"
                        android:textSize="11sp" />

                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchLocation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Share location" />

            </LinearLayout>


            <!-- =================================================
                 START SAFETY CHECK
                 ================================================= -->

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnStartSafetyCheck"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_continue_button"
                android:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:text="Start Safety Check"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>