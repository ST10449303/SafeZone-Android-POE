<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F8FC">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/safezone_navy"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <!-- Back button -->
        <ImageView
            android:id="@+id/tvBack"
            android:layout_width="42dp"
            android:layout_height="match_parent"
            android:layout_alignParentStart="true"
            android:padding="8dp"
            android:src="@drawable/ic_back"
            android:contentDescription="@string/campus_alerts_back"
            android:clickable="true"
            android:focusable="true" />

        <!-- Header title: constrained to prevent overlap -->
        <TextView
            android:id="@+id/tvHeaderTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/tvBack"
            android:layout_toStartOf="@id/ivNotification"
            android:layout_centerVertical="true"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:gravity="center"
            android:text="@string/campus_alerts_header"
            android:textColor="@android:color/white"
            android:textSize="22sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- Notification icon -->
        <ImageView
            android:id="@+id/ivNotification"
            android:layout_width="42dp"
            android:layout_height="match_parent"
            android:layout_alignParentEnd="true"
            android:padding="8dp"
            android:src="@drawable/ic_notifications"
            android:contentDescription="@string/campus_alerts_notifications"
            android:clickable="true"
            android:focusable="true" />

    </RelativeLayout>

    <!-- Scrollable page content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <!-- Page title and introduction -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:padding="13dp"
                    android:background="@drawable/bg_alert_icon_circle"
                    android:src="@drawable/ic_notifications"
                    android:contentDescription="@string/campus_alerts_title" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/campus_alerts_title"
                        android:textColor="#0B2A4A"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/campus_alerts_tagline"
                        android:textColor="#526B8D"
                        android:textSize="16sp" />

                </LinearLayout>

            </LinearLayout>

            <!-- Description -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/campus_alerts_description"
                android:textColor="#58708F"
                android:textSize="15sp"
                android:lineSpacingExtra="3dp" />

            <!-- Campus selector: ID required by Kotlin -->
            <LinearLayout
                android:id="@+id/campusSelector"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_alert_selector"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:orientation="horizontal"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_campus"
                    android:contentDescription="@string/campus_alerts_campus" />

                <TextView
                    android:id="@+id/tvSelectedCampus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:text="@string/campus_alerts_default_campus"
                    android:textColor="#17395F"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_arrow_down"
                    android:contentDescription="@string/campus_alerts_select_campus" />

            </LinearLayout>

            <!-- Alert filters -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- All -->
                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnFilterAll"
                        android:layout_width="82dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_alert_filter_selected"
                        android:backgroundTint="@null"
                        android:stateListAnimator="@null"
                        android:text="@string/campus_alerts_filter_all"
                        android:textAllCaps="false"
                        android:textColor="@android:color/white"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <!-- Emergency -->
                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnFilterEmergency"
                        android:layout_width="112dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_alert_filter"
                        android:backgroundTint="@null"
                        android:stateListAnimator="@null"
                        android:drawableStart="@drawable/ic_alert_emergency"
                        android:drawablePadding="6dp"
                        android:text="@string/campus_alerts_filter_emergency"
                        android:textAllCaps="false"
                        android:textColor="#243B5A"
                        android:textSize="14sp" />

                    <!-- Safety -->
                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnFilterSafety"
                        android:layout_width="100dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_alert_filter"
                        android:backgroundTint="@null"
                        android:stateListAnimator="@null"
                        android:drawableStart="@drawable/ic_shield"
                        android:drawablePadding="6dp"
                        android:text="@string/campus_alerts_filter_safety"
                        android:textAllCaps="false"
                        android:textColor="#243B5A"
                        android:textSize="14sp" />

                    <!-- General -->
                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnFilterGeneral"
                        android:layout_width="100dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_alert_filter"
                        android:backgroundTint="@null"
                        android:stateListAnimator="@null"
                        android:drawableStart="@drawable/ic_info"
                        android:drawablePadding="6dp"
                        android:text="@string/campus_alerts_filter_general"
                        android:textAllCaps="false"
                        android:textColor="#243B5A"
                        android:textSize="14sp" />

                    <!-- Events -->
                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnFilterEvents"
                        android:layout_width="92dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_alert_filter"
                        android:backgroundTint="@null"
                        android:stateListAnimator="@null"
                        android:drawableStart="@drawable/ic_event"
                        android:drawablePadding="6dp"
                        android:text="@string/campus_alerts_filter_events"
                        android:textAllCaps="false"
                        android:textColor="#243B5A"
                        android:textSize="14sp" />

                </LinearLayout>

            </HorizontalScrollView>

            <!-- Alerts are added dynamically by CampusAlertsActivity.kt -->
            <LinearLayout
                android:id="@+id/alertsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="18dp" />

            <!-- Notification prompt: ID required by Kotlin -->
            <LinearLayout
                android:id="@+id/notificationPrompt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_notification_prompt"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:padding="12dp"
                    android:background="@drawable/bg_alert_icon_circle"
                    android:src="@drawable/ic_megaphone"
                    android:contentDescription="@string/campus_alerts_notifications" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/campus_alerts_enable_notifications"
                        android:textColor="#12345A"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/campus_alerts_notification_description"
                        android:textColor="#637A98"
                        android:textSize="13sp" />

                </LinearLayout>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnEnableNotifications"
                    android:layout_width="92dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_alert_primary_button"
                    android:backgroundTint="@null"
                    android:stateListAnimator="@null"
                    android:text="@string/campus_alerts_turn_on"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- Bottom navigation -->
    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="78dp"
        android:background="@android:color/white"
        android:elevation="10dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <!-- Home -->
        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="27dp"
                android:layout_height="27dp"
                android:src="@drawable/ic_home"
                android:contentDescription="@string/campus_alerts_nav_home" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/campus_alerts_nav_home"
                android:textColor="#183B63"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- Map -->
        <LinearLayout
            android:id="@+id/navMap"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="27dp"
                android:layout_height="27dp"
                android:src="@drawable/ic_location"
                android:contentDescription="@string/campus_alerts_nav_map" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/campus_alerts_nav_map"
                android:textColor="#183B63"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- Reports -->
        <LinearLayout
            android:id="@+id/navReports"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="27dp"
                android:layout_height="27dp"
                android:src="@drawable/ic_reports"
                android:contentDescription="@string/campus_alerts_nav_reports" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/campus_alerts_nav_reports"
                android:textColor="#183B63"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- Alerts: selected tab -->
        <LinearLayout
            android:id="@+id/navNotifications"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:background="@drawable/bg_alert_nav_selected"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="27dp"
                android:layout_height="27dp"
                android:src="@drawable/ic_notifications"
                android:contentDescription="@string/campus_alerts_nav_alerts" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/campus_alerts_nav_alerts"
                android:textColor="#1976D2"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Profile -->
        <LinearLayout
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="27dp"
                android:layout_height="27dp"
                android:src="@drawable/ic_person"
                android:contentDescription="@string/campus_alerts_nav_profile" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/campus_alerts_nav_profile"
                android:textColor="#183B63"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>