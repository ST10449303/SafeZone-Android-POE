<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/safezone_white"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ================================= -->
        <!-- SAFEZONE HEADER -->
        <!-- ================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/safezone_navy">

            <!-- Back Arrow -->
            <TextView
                android:id="@+id/tvBack"
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:gravity="center"
                android:text="‹"
                android:textColor="@color/safezone_white"
                android:textSize="38sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

            <!-- SafeZone -->
            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="SafeZone"
                android:textColor="@color/safezone_white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Header Balance -->
            <View
                android:layout_width="55dp"
                android:layout_height="55dp" />

        </LinearLayout>


        <!-- ================================= -->
        <!-- MAIN CONTENT -->
        <!-- ================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="25dp"
            android:paddingBottom="30dp">

            <!-- Title -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Add Trusted Contact"
                android:textColor="@color/safezone_dark"
                android:textSize="21sp"
                android:textStyle="bold" />


            <!-- ================================= -->
            <!-- FULL NAME -->
            <!-- ================================= -->

            <EditText
                android:id="@+id/etFullName"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="22dp"
                android:background="@drawable/rounded_login_input"
                android:drawableStart="@drawable/ic_person"
                android:drawablePadding="12dp"
                android:hint="Full Name"
                android:inputType="textPersonName"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/safezone_dark"
                android:textColorHint="@color/safezone_grey"
                android:textSize="14sp" />


            <!-- ================================= -->
            <!-- RELATIONSHIP -->
            <!-- ================================= -->

            <EditText
                android:id="@+id/etRelationship"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/rounded_login_input"
                android:drawableStart="@drawable/ic_person"
                android:drawablePadding="12dp"
                android:hint="Relationship"
                android:inputType="text"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/safezone_dark"
                android:textColorHint="@color/safezone_grey"
                android:textSize="14sp" />


            <!-- ================================= -->
            <!-- PHONE NUMBER -->
            <!-- ================================= -->

            <EditText
                android:id="@+id/etPhone"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/rounded_login_input"
                android:drawableStart="@drawable/ic_phone"
                android:drawablePadding="12dp"
                android:hint="Phone Number"
                android:inputType="phone"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/safezone_dark"
                android:textColorHint="@color/safezone_grey"
                android:textSize="14sp" />


            <!-- ================================= -->
            <!-- EMAIL ADDRESS -->
            <!-- ================================= -->

            <EditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/rounded_login_input"
                android:drawableStart="@drawable/ic_email"
                android:drawablePadding="12dp"
                android:hint="Email Address"
                android:inputType="textEmailAddress"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/safezone_dark"
                android:textColorHint="@color/safezone_grey"
                android:textSize="14sp" />


            <!-- ================================= -->
            <!-- EMERGENCY ALERTS -->
            <!-- ================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/cbEmergencyAlerts"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:buttonTint="@color/safezone_navy"
                    android:text="Receive Emergency Alerts"
                    android:textColor="@color/safezone_dark"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ON / OFF"
                    android:textColor="@color/safezone_navy"
                    android:textSize="11sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- ================================= -->
            <!-- SAVE CONTACT -->
            <!-- ================================= -->

            <Button
                android:id="@+id/btnSaveContact"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="4dp"
                android:backgroundTint="@color/safezone_navy"
                android:text="Save Contact"
                android:textAllCaps="false"
                android:textColor="@color/safezone_white"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>