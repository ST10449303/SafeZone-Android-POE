<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F7FA">

    <!-- HEADER -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/safezone_navy"
        android:paddingStart="18dp"
        android:paddingEnd="18dp">

        <TextView
            android:id="@+id/tvBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="‹"
            android:textColor="@android:color/white"
            android:textSize="34sp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/campus_reports_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/campus_reports_title"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnRefreshReports"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="↻"
            android:textColor="@android:color/white"
            android:textSize="28sp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/campus_reports_refresh" />

    </LinearLayout>

    <!-- PAGE TITLE -->

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="20dp"
        android:text="@string/campus_reports_heading"
        android:textColor="#172033"
        android:textSize="24sp"
        android:textStyle="bold" />

    <!-- DESCRIPTION -->

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="5dp"
        android:layout_marginEnd="20dp"
        android:text="@string/campus_reports_description"
        android:textColor="#667085"
        android:textSize="15sp" />

    <!-- REPORT SUMMARY -->

    <TextView
        android:id="@+id/tvReportCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="20dp"
        android:text="@string/campus_reports_count_zero"
        android:textColor="#1976D2"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- REPORT AREA -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- EMPTY STATE -->

            <TextView
                android:id="@+id/tvNoReports"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:layout_marginBottom="40dp"
                android:gravity="center"
                android:padding="20dp"
                android:text="@string/campus_reports_empty"
                android:textColor="#667085"
                android:textSize="16sp"
                android:visibility="gone" />

            <!-- DYNAMIC REPORT CARDS -->

            <LinearLayout
                android:id="@+id/reportsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
