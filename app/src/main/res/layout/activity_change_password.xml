<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F7FA">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/safezone_navy"
        android:paddingStart="8dp"
        android:paddingEnd="12dp">

        <TextView
            android:id="@+id/tvBack"
            android:layout_width="50dp"
            android:layout_height="54dp"
            android:gravity="center"
            android:text="@string/change_password_back"
            android:textColor="#FFFFFF"
            android:textSize="38sp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/change_password_back_description" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/change_password_app_name"
            android:textColor="#FFFFFF"
            android:textSize="23sp"
            android:textStyle="bold" />

        <View
            android:layout_width="50dp"
            android:layout_height="50dp" />

    </LinearLayout>

    <!-- Scrollable page content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="30dp"
            android:paddingBottom="30dp">

            <!-- SafeZone logo -->
            <ImageView
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:layout_gravity="center_horizontal"
                android:contentDescription="@string/change_password_logo_description"
                android:src="@drawable/safezone_logo" />

            <!-- Page title -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:text="@string/change_password_title"
                android:textColor="#0B1F3A"
                android:textSize="27sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="@string/change_password_subtitle"
                android:textColor="#667085"
                android:textSize="14sp" />

            <!-- Security information -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:background="@drawable/bg_settings_security"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="14dp">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_settings_security_icon"
                    android:padding="10dp"
                    android:src="@drawable/ic_settings_security"
                    android:contentDescription="@string/change_password_security_description" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:text="@string/change_password_security_tip"
                    android:textColor="#667085"
                    android:textSize="13sp" />

            </LinearLayout>

            <!-- Current password -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:labelFor="@id/etCurrentPassword"
                android:text="@string/change_password_current_label"
                android:textColor="#172033"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etCurrentPassword"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:autofillHints="password"
                android:background="@drawable/rounded_login_input"
                android:hint="@string/change_password_current_hint"
                android:inputType="textPassword"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="#172033"
                android:textColorHint="#98A2B3"
                android:textSize="15sp"
                android:drawableStart="@drawable/ic_lock"
                android:drawableEnd="@drawable/ic_visibility_off"
                android:drawablePadding="10dp" />

            <!-- New password -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:labelFor="@id/etNewPassword"
                android:text="@string/change_password_new_label"
                android:textColor="#172033"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etNewPassword"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:autofillHints="newPassword"
                android:background="@drawable/rounded_login_input"
                android:hint="@string/change_password_new_hint"
                android:inputType="textPassword"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="#172033"
                android:textColorHint="#98A2B3"
                android:textSize="15sp"
                android:drawableStart="@drawable/ic_lock"
                android:drawableEnd="@drawable/ic_visibility_off"
                android:drawablePadding="10dp" />

            <!-- Confirm new password -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:labelFor="@id/etConfirmPassword"
                android:text="@string/change_password_confirm_label"
                android:textColor="#172033"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etConfirmPassword"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:autofillHints="newPassword"
                android:background="@drawable/rounded_login_input"
                android:hint="@string/change_password_confirm_hint"
                android:inputType="textPassword"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="#172033"
                android:textColorHint="#98A2B3"
                android:textSize="15sp"
                android:drawableStart="@drawable/ic_lock"
                android:drawableEnd="@drawable/ic_visibility_off"
                android:drawablePadding="10dp" />

            <!-- Password requirements -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="@string/change_password_requirements_title"
                android:textColor="#172033"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/change_password_requirements_list"
                android:textColor="#667085"
                android:textSize="12sp"
                android:lineSpacingExtra="3dp" />

            <!-- Change password button -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnChangePassword"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="25dp"
                android:background="@drawable/bg_primary_button"
                android:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:text="@string/change_password_button"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Success message controlled by Kotlin -->
            <TextView
                android:id="@+id/tvSuccess"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:text="@string/change_password_success"
                android:textColor="#2E7D32"
                android:textSize="15sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- Return to settings -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnBackToSettings"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="15dp"
                android:background="@drawable/bg_secondary_button"
                android:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:text="@string/change_password_back_to_settings"
                android:textAllCaps="false"
                android:textColor="#0B1F3A"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
