<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F7FA">

    <!-- SafeZone header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="74dp"
        android:background="@color/safezone_navy"
        android:paddingStart="22dp"
        android:paddingEnd="18dp">

        <TextView
            android:id="@+id/tvSafeZone"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:text="@string/campus_home_header"
            android:textColor="@android:color/white"
            android:textSize="25sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/tvNotification"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="62dp"
            android:padding="5dp"
            android:src="@drawable/ic_notification"
            android:contentDescription="@string/campus_home_nav_alerts" />

        <ImageView
            android:id="@+id/tvProfile"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_profile"
            android:contentDescription="@string/campus_home_nav_profile" />

    </RelativeLayout>

    <!-- Main content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="26dp"
            android:paddingEnd="26dp"
            android:paddingTop="28dp"
            android:paddingBottom="28dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/campus_home_title"
                android:textColor="#0B1F3A"
                android:textSize="34sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvWelcome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/campus_home_welcome_default"
                android:textColor="#50698A"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/campus_home_tagline"
                android:textColor="#58708F"
                android:textSize="16sp" />

            <!-- Campus connection card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="18dp"
                android:background="@drawable/bg_campus_connection"
                android:elevation="3dp">

                <LinearLayout
                    android:layout_width="92dp"
                    android:layout_height="92dp"
                    android:gravity="center"
                    android:background="@drawable/bg_campus_icon_circle">

                    <ImageView
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:src="@drawable/ic_campus_building"
                        android:contentDescription="@string/campus_home_campus_icon" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="20dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvCampusName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/campus_home_default_campus"
                        android:textColor="#0B1F3A"
                        android:textSize="21sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/campus_home_connection_title"
                        android:textColor="#50698A"
                        android:textSize="15sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical">

                        <View
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:background="@drawable/bg_status_available" />

                        <TextView
                            android:id="@+id/tvCampusStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="9dp"
                            android:text="@string/campus_home_status_available"
                            android:textColor="#159447"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="25dp"
                            android:layout_height="25dp"
                            android:src="@drawable/ic_clock"
                            android:contentDescription="@string/campus_home_hours_description" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/campus_home_hours"
                            android:textColor="#50698A"
                            android:textSize="14sp" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <!-- Report campus incident -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnReportCampusIncident"
                android:layout_width="match_parent"
                android:layout_height="108dp"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_campus_action_white"
                android:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:gravity="center_vertical"
                android:paddingStart="24dp"
                android:paddingEnd="20dp"
                android:text="@string/campus_home_report_incident"
                android:textAllCaps="false"
                android:textColor="#0B1F3A"
                android:textSize="17sp"
                android:textStyle="bold"
                android:drawableStart="@drawable/ic_incident_report"
                android:drawableEnd="@drawable/ic_arrow_right"
                android:drawablePadding="18dp" />

            <!-- Campus emergency -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnCampusEmergency"
                android:layout_width="match_parent"
                android:layout_height="108dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_campus_emergency"
                android:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:gravity="center_vertical"
                android:paddingStart="24dp"
                android:paddingEnd="20dp"
                android:text="@string/campus_home_emergency"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="17sp"
                android:textStyle="bold"
                android:drawableStart="@drawable/ic_emergency_white"
                android:drawableEnd="@drawable/ic_arrow_right_white"
                android:drawablePadding="18dp" />

            <!-- Campus safety map -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnCampusSafetyMap"
                android:layout_width="match_parent"
                android:layout_height="108dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_campus_action_white"
                android:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:gravity="center_vertical"
                android:paddingStart="24dp"
                android:paddingEnd="20dp"
                android:text="@string/campus_home_safety_map"
                android:textAllCaps="false"
                android:textColor="#0B1F3A"
                android:textSize="17sp"
                android:textStyle="bold"
                android:drawableStart="@drawable/ic_location_blue"
                android:drawableEnd="@drawable/ic_arrow_right"
                android:drawablePadding="18dp" />

            <!-- Campus alerts -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnCampusAlerts"
                android:layout_width="match_parent"
                android:layout_height="108dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_campus_action_white"
                android:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:gravity="center_vertical"
                android:paddingStart="24dp"
                android:paddingEnd="20dp"
                android:text="@string/campus_home_alerts"
                android:textAllCaps="false"
                android:textColor="#0B1F3A"
                android:textSize="17sp"
                android:textStyle="bold"
                android:drawableStart="@drawable/ic_alert_bell"
                android:drawableEnd="@drawable/ic_arrow_right"
                android:drawablePadding="18dp" />

            <!-- My campus reports -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnMyCampusReports"
                android:layout_width="match_parent"
                android:layout_height="108dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_campus_action_white"
                android:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:gravity="center_vertical"
                android:paddingStart="24dp"
                android:paddingEnd="20dp"
                android:text="@string/campus_home_my_reports"
                android:textAllCaps="false"
                android:textColor="#0B1F3A"
                android:textSize="17sp"
                android:textStyle="bold"
                android:drawableStart="@drawable/ic_report_document"
                android:drawableEnd="@drawable/ic_arrow_right"
                android:drawablePadding="18dp" />

            <!-- Logout -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_logout_button"
                android:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:gravity="center"
                android:text="@string/campus_home_logout"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="17sp"
                android:textStyle="bold" />

        </LinearLayout>
    </ScrollView>

    <!-- Bottom navigation -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="92dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@android:color/white"
        android:elevation="8dp"
        android:paddingTop="8dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_home_blue"
                android:contentDescription="@string/campus_home_nav_home" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/campus_home_nav_home"
                android:textColor="#1976D2"
                android:textSize="14sp"
                android:textStyle="bold" />

            <View
                android:layout_width="76dp"
                android:layout_height="3dp"
                android:layout_marginTop="5dp"
                android:background="#1976D2" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navMap"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_map_outline"
                android:contentDescription="@string/campus_home_nav_map" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/campus_home_nav_map"
                android:textColor="#506174"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navReports"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_report_outline"
                android:contentDescription="@string/campus_home_nav_reports" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/campus_home_nav_reports"
                android:textColor="#506174"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navNotifications"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_bell_outline"
                android:contentDescription="@string/campus_home_nav_alerts" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/campus_home_nav_alerts"
                android:textColor="#506174"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_profile_outline"
                android:contentDescription="@string/campus_home_nav_profile" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/campus_home_nav_profile"
                android:textColor="#506174"
                android:textSize="14sp" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
