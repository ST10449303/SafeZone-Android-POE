<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F7FA">

    <!-- ===================================================== -->
    <!-- SAFEZONE HEADER -->
    <!-- ===================================================== -->

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="74dp"
        android:background="@color/safezone_navy"
        android:paddingStart="22dp"
        android:paddingEnd="18dp">

        <TextView
            android:id="@+id/tvSafeZone"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:text="SafeZone"
            android:textColor="@android:color/white"
            android:textSize="25sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/tvNotification"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="62dp"
            android:padding="5dp"
            android:src="@drawable/ic_notification"
            android:contentDescription="Notifications" />

        <ImageView
            android:id="@+id/tvProfile"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_profile"
            android:contentDescription="Profile" />

    </RelativeLayout>

    <!-- ===================================================== -->
    <!-- MAIN CONTENT -->
    <!-- ===================================================== -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="26dp"
            android:paddingEnd="26dp"
            android:paddingTop="28dp"
            android:paddingBottom="28dp">

            <!-- PAGE TITLE -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Campus Safety"
                android:textColor="#0B1F3A"
                android:textSize="34sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvWelcome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Welcome, Learner 👋"
                android:textColor="#50698A"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Your safety matters. Stay informed, stay safe."
                android:textColor="#58708F"
                android:textSize="16sp" />

            <!-- ================================================= -->
            <!-- CAMPUS CONNECTION CARD -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="18dp"
                android:background="@drawable/bg_campus_connection"
                android:elevation="3dp">

                <LinearLayout
                    android:layout_width="92dp"
                    android:layout_height="92dp"
                    android:gravity="center"
                    android:background="@drawable/bg_campus_icon_circle">

                    <ImageView
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:src="@drawable/ic_campus_building"
                        android:contentDescription="Campus" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="20dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvCampusName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Pretoria Campus"
                        android:textColor="#0B1F3A"
                        android:textSize="21sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Campus Safety Connection"
                        android:textColor="#50698A"
                        android:textSize="15sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical">

                        <View
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:background="@drawable/bg_status_available" />

                        <TextView
                            android:id="@+id/tvCampusStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="9dp"
                            android:text="Status: Available"
                            android:textColor="#159447"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="25dp"
                            android:layout_height="25dp"
                            android:src="@drawable/ic_clock"
                            android:contentDescription="Campus hours" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="Monday – Friday | 07:00 – 18:00"
                            android:textColor="#50698A"
                            android:textSize="14sp" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <!-- ================================================= -->
            <!-- REPORT CAMPUS INCIDENT -->
            <!-- ================================================= -->

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnReportCampusIncident"
                android:layout_width="match_parent"
                android:layout_height="108dp"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_campus_action_white"
                android:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:gravity="center_vertical"
                android:paddingStart="24dp"
                android:paddingEnd="20dp"
                android:text="Report Campus Incident\nReport a safety concern on campus."
                android:textAllCaps="false"
                android:textColor="#0B1F3A"
                android:textSize="17sp"
                android:textStyle="bold"
                android:drawableStart="@drawable/ic_incident_report"
                android:drawableEnd="@drawable/ic_arrow_right"
                android:drawablePadding="18dp" />

            <!-- ================================================= -->
            <!-- CAMPUS EMERGENCY -->
            <!-- ================================================= -->

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnCampusEmergency"
                android:layout_width="match_parent"
                android:layout_height="108dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_campus_emergency"
                android:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:gravity="center_vertical"
                android:paddingStart="24dp"
                android:paddingEnd="20dp"
                android:text="Campus Emergency\nGet immediate help on campus."
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="17sp"
                android:textStyle="bold"
                android:drawableStart="@drawable/ic_emergency_white"
                android:drawableEnd="@drawable/ic_arrow_right_white"
                android:drawablePadding="18dp" />

            <!-- ================================================= -->
            <!-- CAMPUS SAFETY MAP -->
            <!-- ================================================= -->

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnCampusSafetyMap"
                android:layout_width="match_parent"
                android:layout_height="108dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_campus_action_white"
                android:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:gravity="center_vertical"
                android:paddingStart="24dp"
                android:paddingEnd="20dp"
                android:text="Campus Safety Map\nView safety resources and locations."
                android:textAllCaps="false"
                android:textColor="#0B1F3A"
                android:textSize="17sp"
                android:textStyle="bold"
                android:drawableStart="@drawable/ic_location_blue"
                android:drawableEnd="@drawable/ic_arrow_right"
                android:drawablePadding="18dp" />

            <!-- ================================================= -->
            <!-- CAMPUS ALERTS -->
            <!-- ================================================= -->

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnCampusAlerts"
                android:layout_width="match_parent"
                android:layout_height="108dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_campus_action_white"
                android:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:gravity="center_vertical"
                android:paddingStart="24dp"
                android:paddingEnd="20dp"
                android:text="Campus Alerts\nStay updated with important alerts."
                android:textAllCaps="false"
                android:textColor="#0B1F3A"
                android:textSize="17sp"
                android:textStyle="bold"
                android:drawableStart="@drawable/ic_alert_bell"
                android:drawableEnd="@drawable/ic_arrow_right"
                android:drawablePadding="18dp" />

            <!-- ================================================= -->
            <!-- MY CAMPUS REPORTS -->
            <!-- ================================================= -->

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnMyCampusReports"
                android:layout_width="match_parent"
                android:layout_height="108dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_campus_action_white"
                android:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:gravity="center_vertical"
                android:paddingStart="24dp"
                android:paddingEnd="20dp"
                android:text="My Campus Reports\nView and manage your reported incidents."
                android:textAllCaps="false"
                android:textColor="#0B1F3A"
                android:textSize="17sp"
                android:textStyle="bold"
                android:drawableStart="@drawable/ic_report_document"
                android:drawableEnd="@drawable/ic_arrow_right"
                android:drawablePadding="18dp" />

            <!-- ================================================= -->
            <!-- LOGOUT -->
            <!-- ================================================= -->

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_logout_button"
                android:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:gravity="center"
                android:text="LOG OUT"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="17sp"
                android:textStyle="bold" />

        </LinearLayout>

    </ScrollView>

    <!-- ===================================================== -->
    <!-- BOTTOM NAVIGATION -->
    <!-- ===================================================== -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="92dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@android:color/white"
        android:elevation="8dp"
        android:paddingTop="8dp"
        android:paddingBottom="6dp">

        <!-- HOME -->

        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_home_blue"
                android:contentDescription="Home" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Home"
                android:textColor="#1976D2"
                android:textSize="14sp"
                android:textStyle="bold" />

            <View
                android:layout_width="76dp"
                android:layout_height="3dp"
                android:layout_marginTop="5dp"
                android:background="#1976D2" />

        </LinearLayout>

        <!-- MAP -->

        <LinearLayout
            android:id="@+id/navMap"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_map_outline"
                android:contentDescription="Map" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Map"
                android:textColor="#506174"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- REPORTS -->

        <LinearLayout
            android:id="@+id/navReports"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_report_outline"
                android:contentDescription="Reports" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Reports"
                android:textColor="#506174"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- ALERTS -->

        <LinearLayout
            android:id="@+id/navNotifications"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_bell_outline"
                android:contentDescription="Alerts" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Alerts"
                android:textColor="#506174"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- PROFILE -->

        <LinearLayout
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_profile_outline"
                android:contentDescription="Profile" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Profile"
                android:textColor="#506174"
                android:textSize="14sp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
