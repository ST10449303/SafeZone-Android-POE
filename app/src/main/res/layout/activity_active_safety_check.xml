<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/safezone_white"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ============================= -->
        <!-- SAFEZONE HEADER -->
        <!-- ============================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/safezone_navy">

            <TextView
                android:id="@+id/tvBack"
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:gravity="center"
                android:text="‹"
                android:textColor="@color/safezone_white"
                android:textSize="38sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="SafeZone"
                android:textColor="@color/safezone_white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <View
                android:layout_width="55dp"
                android:layout_height="55dp" />

        </LinearLayout>


        <!-- ============================= -->
        <!-- CONTENT -->
        <!-- ============================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="28dp"
            android:paddingBottom="30dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Safety Check Active"
                android:textColor="@color/safezone_dark"
                android:textSize="21sp"
                android:textStyle="bold" />

            <!-- Countdown -->

            <TextView
                android:id="@+id/tvCountdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="00:30:00"
                android:textColor="@color/safezone_navy"
                android:textSize="34sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="Your safety check is active."
                android:textColor="@color/safezone_grey"
                android:textSize="13sp" />


            <!-- Information -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:orientation="vertical"
                android:padding="14dp"
                android:background="@drawable/rounded_login_input">

                <TextView
                    android:id="@+id/tvTrustedContact"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Trusted Contact: --"
                    android:textColor="@color/safezone_dark"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvLocationSharing"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Location Sharing: OFF"
                    android:textColor="@color/safezone_dark"
                    android:textSize="14sp" />

            </LinearLayout>


            <!-- I'M SAFE -->

            <Button
                android:id="@+id/btnImSafe"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="22dp"
                android:backgroundTint="#2E7D32"
                android:text="I'M SAFE"
                android:textAllCaps="false"
                android:textColor="@color/safezone_white"
                android:textSize="16sp"
                android:textStyle="bold" />


            <!-- CANCEL -->

            <Button
                android:id="@+id/btnCancelCheckIn"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/safezone_white"
                android:text="Cancel Check-In"
                android:textAllCaps="false"
                android:textColor="@color/safezone_dark"
                android:textSize="15sp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>