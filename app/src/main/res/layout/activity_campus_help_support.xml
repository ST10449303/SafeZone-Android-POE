<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F7FA">

    <!-- ===================================================== -->
    <!-- HEADER -->
    <!-- ===================================================== -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#0B1F3A"
        android:paddingStart="18dp"
        android:paddingEnd="18dp">

        <TextView
            android:id="@+id/tvBack"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:gravity="center"
            android:text="‹"
            android:textColor="#FFFFFF"
            android:textSize="38sp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Help &amp; Support"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <View
            android:layout_width="50dp"
            android:layout_height="50dp" />

    </LinearLayout>


    <!-- ===================================================== -->
    <!-- CONTENT -->
    <!-- ===================================================== -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">


            <!-- ================================================= -->
            <!-- TITLE -->
            <!-- ================================================= -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="How can we help?"
                android:textColor="#172033"
                android:textSize="25sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Find help and support for using SafeZone."
                android:textColor="#667085"
                android:textSize="15sp"
                android:layout_marginBottom="20dp" />


            <!-- ================================================= -->
            <!-- ACCOUNT HELP -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/rowAccountHelp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="70dp"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:padding="18dp"
                android:background="@drawable/bg_settings_card"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Account Help"
                    android:textColor="#172033"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Get help with your account and password."
                    android:textColor="#667085"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- SAFETY HELP -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/rowSafetyHelp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="70dp"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:padding="18dp"
                android:background="@drawable/bg_settings_card"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Safety Help"
                    android:textColor="#172033"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Learn how to report incidents and stay safe."
                    android:textColor="#667085"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- EMERGENCY HELP -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/rowEmergencyHelp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="70dp"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:padding="18dp"
                android:background="@drawable/bg_settings_card"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Emergency Help"
                    android:textColor="#172033"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Learn what to do during an emergency."
                    android:textColor="#667085"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- CONTACT SUPPORT -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/rowContactSupport"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="70dp"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:padding="18dp"
                android:background="@drawable/bg_settings_card"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Contact Support"
                    android:textColor="#172033"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Contact the SafeZone support team."
                    android:textColor="#667085"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- FAQ -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/rowFaq"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="70dp"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:padding="18dp"
                android:background="@drawable/bg_settings_card"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Frequently Asked Questions"
                    android:textColor="#172033"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Find answers to common SafeZone questions."
                    android:textColor="#667085"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- EMERGENCY NOTICE -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp"
                android:background="@drawable/bg_settings_security"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Emergency"
                    android:textColor="#C62828"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="If you are in immediate danger, use the Emergency Assistance feature or call 112."
                    android:textColor="#667085"
                    android:textSize="14sp"
                    android:layout_marginTop="6dp" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>