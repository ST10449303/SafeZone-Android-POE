<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/safezone_white">

    <!-- SafeZone Header -->
    <TextView
        android:id="@+id/tvHeader"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@color/safezone_navy"
        android:gravity="center"
        android:text="@string/app_name"
        android:textColor="@color/safezone_white"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- Scrollable Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:paddingBottom="24dp">

            <!-- SafeZone Logo -->
            <ImageView
                android:id="@+id/imgSafeZoneLogo"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="28dp"
                android:contentDescription="@string/safezone_logo_description"
                android:src="@drawable/safezone_logo"
                android:scaleType="fitCenter" />

            <!-- Create New Password Title -->
            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:text="@string/create_new_password"
                android:textColor="@color/safezone_dark"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- Instructions Caption -->
            <TextView
                android:id="@+id/tvInstructions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:text="@string/create_new_password_instructions"
                android:textColor="@color/safezone_grey"
                android:textSize="13sp" />

            <!-- New Password Label -->
            <TextView
                android:id="@+id/tvNewPasswordLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/new_password"
                android:textColor="@color/safezone_dark"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- New Password Field -->
            <EditText
                android:id="@+id/etNewPassword"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/rounded_login_input"
                android:drawableStart="@drawable/ic_lock"
                android:drawableEnd="@drawable/ic_visibility_off"
                android:drawablePadding="10dp"
                android:hint="@string/enter_new_password"
                android:inputType="textPassword"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/safezone_dark"
                android:textColorHint="@color/safezone_grey"
                android:textSize="14sp" />

            <!-- Confirm Password Label -->
            <TextView
                android:id="@+id/tvConfirmPasswordLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/confirm_new_password"
                android:textColor="@color/safezone_dark"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- Confirm Password Field -->
            <EditText
                android:id="@+id/etConfirmPassword"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/rounded_login_input"
                android:drawableStart="@drawable/ic_lock"
                android:drawableEnd="@drawable/ic_visibility_off"
                android:drawablePadding="10dp"
                android:hint="@string/confirm_new_password_hint"
                android:inputType="textPassword"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/safezone_dark"
                android:textColorHint="@color/safezone_grey"
                android:textSize="14sp" />

            <!-- Reset Password Button -->
            <Button
                android:id="@+id/btnResetPassword"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="24dp"
                android:backgroundTint="@color/safezone_navy"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:text="@string/reset_password"
                android:textAllCaps="false"
                android:textColor="@color/safezone_white"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- Password Reset Success Message -->
            <TextView
                android:id="@+id/tvSuccess"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:text="@string/password_reset_successful"
                android:textColor="@color/safezone_navy"
                android:textSize="16sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- Password Reset Confirmation -->
            <TextView
                android:id="@+id/tvConfirmation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/new_password_saved"
                android:textColor="@color/safezone_grey"
                android:textSize="13sp"
                android:visibility="gone" />

            <!-- Back to Login Button -->
            <Button
                android:id="@+id/btnBackToLogin"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="24dp"
                android:backgroundTint="@color/safezone_blue"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:text="@string/back_to_login"
                android:textAllCaps="false"
                android:textColor="@color/safezone_white"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
