<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/safezone_white">

    <!-- SafeZone Full-Width Top Navigation -->
    <TextView
        android:id="@+id/tvHeader"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@color/safezone_navy"
        android:gravity="center"
        android:text="SafeZone"
        android:textColor="@color/safezone_white"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- Scrollable Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="24dp">

            <!-- SafeZone Logo -->
            <ImageView
                android:id="@+id/imgSafeZoneLogo"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:layout_marginTop="22dp"
                android:contentDescription="SafeZone Logo"
                android:src="@drawable/safezone_logo"
                android:scaleType="fitCenter" />

            <!-- Page Title -->
            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:text="Create New Password"
                android:textColor="@color/safezone_dark"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- Instructions -->
            <TextView
                android:id="@+id/tvInstructions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:text="Create a new password for your SafeZone account."
                android:textColor="@color/safezone_grey"
                android:textSize="14sp" />

            <!-- New Password Label -->
            <TextView
                android:id="@+id/tvNewPasswordLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:text="New Password"
                android:textColor="@color/safezone_dark"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- New Password -->
            <EditText
                android:id="@+id/etNewPassword"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/rounded_login_input"
                android:drawableStart="@drawable/ic_lock"
                android:drawableEnd="@drawable/ic_visibility_off"
                android:drawablePadding="12dp"
                android:hint="Enter new password"
                android:inputType="textPassword"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@color/safezone_dark"
                android:textColorHint="@color/safezone_grey"
                android:textSize="16sp" />

            <!-- Confirm Password Label -->
            <TextView
                android:id="@+id/tvConfirmPasswordLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Confirm New Password"
                android:textColor="@color/safezone_dark"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Confirm Password -->
            <EditText
                android:id="@+id/etConfirmPassword"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/rounded_login_input"
                android:drawableStart="@drawable/ic_lock"
                android:drawableEnd="@drawable/ic_visibility_off"
                android:drawablePadding="12dp"
                android:hint="Confirm new password"
                android:inputType="textPassword"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@color/safezone_dark"
                android:textColorHint="@color/safezone_grey"
                android:textSize="16sp" />

            <!-- Reset Password Button -->
            <Button
                android:id="@+id/btnResetPassword"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="22dp"
                android:backgroundTint="@color/safezone_navy"
                android:text="RESET PASSWORD"
                android:textAllCaps="false"
                android:textColor="@color/safezone_white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Success Message -->
            <TextView
                android:id="@+id/tvSuccess"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:text="✓ Password Reset Successful!"
                android:textColor="@color/safezone_navy"
                android:textSize="17sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- Confirmation Message -->
            <TextView
                android:id="@+id/tvConfirmation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="Your new password has been saved successfully."
                android:textColor="@color/safezone_grey"
                android:textSize="14sp"
                android:visibility="gone" />

            <!-- Back to Login -->
            <Button
                android:id="@+id/btnBackToLogin"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="30dp"
                android:backgroundTint="@color/safezone_blue"
                android:text="BACK TO LOGIN"
                android:textAllCaps="false"
                android:textColor="@color/safezone_white"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>