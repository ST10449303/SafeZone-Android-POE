<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F7FA">

    <!-- ================= HEADER ================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/safezone_navy"
        android:paddingStart="10dp"
        android:paddingEnd="18dp">

        <TextView
            android:id="@+id/tvBack"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:gravity="center"
            android:text="‹"
            android:textColor="#FFFFFF"
            android:textSize="38sp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="SafeZone"
            android:textColor="#FFFFFF"
            android:textSize="23sp"
            android:textStyle="bold" />

        <View
            android:layout_width="50dp"
            android:layout_height="50dp" />

    </LinearLayout>


    <!-- ================= CONTENT ================= -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="22dp"
            android:paddingBottom="28dp">


            <!-- MEDICAL ICON -->

            <TextView
                android:layout_width="74dp"
                android:layout_height="74dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/bg_emergency_icon"
                android:gravity="center"
                android:text="✚"
                android:textColor="#D32F2F"
                android:textSize="42sp"
                android:textStyle="bold" />


            <!-- TITLE -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:text="What type of assistance&#10;do you need?"
                android:textColor="#0B1F3A"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="Select the type of emergency assistance you need."
                android:textColor="#667085"
                android:textSize="14sp" />


            <!-- ================= OPTION ROW 1 ================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="145dp"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <!-- MEDICAL -->

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnMedical"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_emergency_card"
                    android:backgroundTint="@null"
                    android:stateListAnimator="@null"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="12dp"
                    android:gravity="center"
                    android:text="✚&#10;&#10;Medical&#10;Emergency"
                    android:textAllCaps="false"
                    android:textColor="#172033"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- INJURY -->

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnInjury"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_emergency_card"
                    android:backgroundTint="@null"
                    android:stateListAnimator="@null"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="12dp"
                    android:gravity="center"
                    android:text="⚕&#10;&#10;Injury / Fall"
                    android:textAllCaps="false"
                    android:textColor="#172033"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- ================= OPTION ROW 2 ================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="145dp"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <!-- ACCIDENT -->

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnAccident"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_emergency_card"
                    android:backgroundTint="@null"
                    android:stateListAnimator="@null"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="12dp"
                    android:gravity="center"
                    android:text="🚗&#10;&#10;Accident"
                    android:textAllCaps="false"
                    android:textColor="#172033"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- FIRE -->

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnFire"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_emergency_card"
                    android:backgroundTint="@null"
                    android:stateListAnimator="@null"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="12dp"
                    android:gravity="center"
                    android:text="🔥&#10;&#10;Fire"
                    android:textAllCaps="false"
                    android:textColor="#172033"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- ================= OPTION ROW 3 ================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="145dp"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <!-- SECURITY -->

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnSecurity"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_emergency_card"
                    android:backgroundTint="@null"
                    android:stateListAnimator="@null"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="12dp"
                    android:gravity="center"
                    android:text="🛡&#10;&#10;Security&#10;Emergency"
                    android:textAllCaps="false"
                    android:textColor="#172033"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- HARASSMENT -->

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnHarassment"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_emergency_card"
                    android:backgroundTint="@null"
                    android:stateListAnimator="@null"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="12dp"
                    android:gravity="center"
                    android:text="👥&#10;&#10;Harassment"
                    android:textAllCaps="false"
                    android:textColor="#172033"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- ================= OTHER ================= -->

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnOther"
                android:layout_width="match_parent"
                android:layout_height="82dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_emergency_card"
                android:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:gravity="center_vertical"
                android:paddingStart="22dp"
                android:text="•••    Other Assistance"
                android:textAllCaps="false"
                android:textColor="#172033"
                android:textSize="15sp"
                android:textStyle="bold" />


            <!-- ================= SELECTED ASSISTANCE ================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_selected_assistance"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="15dp">

                <TextView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:gravity="center"
                    android:text="✓"
                    android:textColor="#1976D2"
                    android:textSize="27sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Selected Assistance"
                        android:textColor="#0B1F3A"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSelectedType"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="No assistance type selected"
                        android:textColor="#667085"
                        android:textSize="13sp" />

                </LinearLayout>

            </LinearLayout>


            <!-- ================= CONTINUE ================= -->

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnContinue"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_continue_button"
                android:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:gravity="center"
                android:text="Continue  →"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>