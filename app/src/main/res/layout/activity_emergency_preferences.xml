<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F7FA">

    <!-- HEADER -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/safezone_navy"
        android:paddingStart="8dp"
        android:paddingEnd="12dp">

        <TextView
            android:id="@+id/tvBack"
            android:layout_width="50dp"
            android:layout_height="54dp"
            android:gravity="center"
            android:text="@string/emergency_preferences_back"
            android:textColor="#FFFFFF"
            android:textSize="38sp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/emergency_preferences_back_description" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/emergency_preferences_app_name"
            android:textColor="#FFFFFF"
            android:textSize="23sp"
            android:textStyle="bold" />

        <View
            android:layout_width="50dp"
            android:layout_height="50dp" />

    </LinearLayout>

    <!-- SCROLLABLE CONTENT -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- LOGO -->

            <ImageView
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:layout_gravity="center_horizontal"
                android:src="@drawable/safezone_logo"
                android:contentDescription="@string/emergency_preferences_logo_description" />

            <!-- TITLE -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:text="@string/emergency_preferences_title"
                android:textColor="#0B1F3A"
                android:textSize="27sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="@string/emergency_preferences_subtitle"
                android:textColor="#667085"
                android:textSize="14sp" />

            <!-- EMERGENCY SERVICES -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="78dp"
                android:layout_marginTop="25dp"
                android:background="@drawable/bg_settings_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_settings_icon"
                    android:padding="10dp"
                    android:src="@drawable/ic_settings_emergency"
                    android:contentDescription="@string/emergency_preferences_services" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/emergency_preferences_services"
                        android:textColor="#172033"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/emergency_preferences_services_description"
                        android:textColor="#667085"
                        android:textSize="12sp" />

                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchEmergencyServices"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:contentDescription="@string/emergency_preferences_services" />

            </LinearLayout>

            <!-- LOCATION DURING EMERGENCY -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="78dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_settings_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_settings_icon"
                    android:padding="10dp"
                    android:src="@drawable/ic_settings_location"
                    android:contentDescription="@string/emergency_preferences_location" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/emergency_preferences_location"
                        android:textColor="#172033"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/emergency_preferences_location_description"
                        android:textColor="#667085"
                        android:textSize="12sp" />

                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchEmergencyLocation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:contentDescription="@string/emergency_preferences_location" />

            </LinearLayout>

            <!-- TRUSTED CONTACT ALERTS -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="78dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_settings_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_settings_icon"
                    android:padding="10dp"
                    android:src="@drawable/ic_settings_contacts"
                    android:contentDescription="@string/emergency_preferences_contacts" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/emergency_preferences_contacts"
                        android:textColor="#172033"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/emergency_preferences_contacts_description"
                        android:textColor="#667085"
                        android:textSize="12sp" />

                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchTrustedContactAlerts"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:contentDescription="@string/emergency_preferences_contacts" />

            </LinearLayout>

            <!-- EMERGENCY NUMBER -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:labelFor="@id/etEmergencyNumber"
                android:text="@string/emergency_preferences_number_label"
                android:textColor="#172033"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etEmergencyNumber"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:autofillHints="phone"
                android:background="@drawable/rounded_login_input"
                android:hint="@string/emergency_preferences_number_hint"
                android:inputType="phone"
                android:text="112"
                android:textColor="#172033"
                android:textColorHint="#98A2B3"
                android:textSize="15sp"
                android:singleLine="true" />

            <!-- SAVE PREFERENCES -->

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSavePreferences"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="25dp"
                android:background="@drawable/bg_primary_button"
                android:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:text="@string/emergency_preferences_save"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- BACK TO SETTINGS -->

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnBackToSettings"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="15dp"
                android:background="@drawable/bg_secondary_button"
                android:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:text="@string/emergency_preferences_back_to_settings"
                android:textAllCaps="false"
                android:textColor="#0B1F3A"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
